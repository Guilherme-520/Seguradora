CORS_ORIGINS=http://localhost:5173,https://seu-dominio-frontend.com

# =============================================================
# Frontend (variáveis com prefixo VITE_ são expostas ao browser)
# =============================================================
# Local: o Vite faz proxy de /api para localhost:3001, então pode ficar vazio.
# No Vercel deixe sem definir (frontend e API estão no mesmo domínio).
# Só preencha se o backend estiver em outro domínio.
VITE_API_URL=
